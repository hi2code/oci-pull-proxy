{
  "server": {
    "listen": ":8443",
    "tls_cert": "/certs/fullchain.pem",
    "tls_key": "/certs/privkey.pem"
  },
  "auth": {
    "enabled": true,
    "username": "myuser",
    "password_env": "PROXY_PASSWORD"
  },
  "cache": {
    "directory": "/data/cache",
    "max_size_gb": 40
  },
  "registries": {
    "docker.io": {
      "upstream": "https://registry-1.docker.io"
    },
    "ghcr.io": {
      "upstream": "https://ghcr.io"
    },
    "quay.io": {
      "upstream": "https://quay.io"
    }
  }
}
