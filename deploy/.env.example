# 必填：代理域名和客户端登录账号密码。
PROXY_DOMAIN=images.example.com
PROXY_USERNAME=myuser
PROXY_PASSWORD=replace-with-a-long-random-secret

# 可选：私有 GHCR 镜像；同时填写用户名和 Token，不需要则留空。
# 使用有 read:packages 权限的 GitHub personal access token (classic)。
GHCR_USERNAME=
GHCR_TOKEN=

# 可选：Docker Hub / Quay 私有镜像。
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
# QUAY_USERNAME=
# QUAY_TOKEN=

# 可选：Docker Hub 公共镜像加速 Token；留空会自动生成并写回此 .env 文件。
TOKEN=

# 可选：缓存容量，默认 40 GiB。
# CACHE_MAX_SIZE_GB=40

# 可选：自定义仓库；每个仓库换一个组名即可，无需额外列表。
# REGISTRY_CORP_DOMAIN=registry.example.com:5000
# REGISTRY_CORP_USERNAME=robot
# REGISTRY_CORP_PASSWORD=your-registry-token

# HTTPS 默认为自动证书。Cloudflare、手动证书等高级配置见 README。
